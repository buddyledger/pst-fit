# LaTeX build files.
# PDFs are not ignored: doc/pst-fit-doc.pdf is tracked and ships to CTAN.

# Core
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.synctex.gz(busy)

# DVI / PostScript route (PSTricks)
*.dvi
*.ps
*.eps.bak
*-pics.pdf
*-autopp.*
*-pst.*
*.pre

# Bibliography
*.bbl
*.bcf
*.blg
*.run.xml
*-blx.bib

# Index and glossary
*.idx
*.ilg
*.ind
*.glo
*.gls
*.glg

# hyperref, beamer, misc
*.brf
*.nav
*.snm
*.vrb
*.lol
*.thm
*.xdv

# Data files written by doc/pst-fit-doc.data when the doc is compiled
/doc/*.dat

# Editor and OS files
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# Local copy of the CTAN archive
/build/

# PostScript sources that belong to the repository
!/tools/*.ps
