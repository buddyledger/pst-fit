% ---------------------------------------------------------------------------
% BIGNUM FORMAT
%   A bignum is a 3-element array   [ sign digits exponent ]
%     sign      boolean  true = positive (or zero), false = negative
%     digits    string of ASCII digits, normally exactly bnn long, first digit
%               non-zero (unless the value is zero)
%     exponent  integer
%   value = sign * (digits read as an integer) * 10^exponent
%   e.g. with 5 setbnsize, 509 is [true (50900) -2]
%
% PRECISION
%   n setbnsize      every result is rounded (half away from zero) to n
%                    significant digits.  Default 20.
%
% PUBLIC PROCEDURES                                   (see README.md)
%   any  setbn  bn         integer, real, string like (-1.25e-3), or bignum
%   bn   bncvs  string     e.g. (+1.2500e-3)
%   bn   bnPrint  -        prints bncvs
%   bn   bncvr  real
%   a b  addbn subbn mulbn divbn            bn
%   a    negbn absbn truncbn roundbn        bn
%   a b  cmpbn  int (-1 0 1)
%   a b  eqbn nebn gtbn gebn ltbn lebn      bool
%   a    bniszero  bool
%   a    sinbn cosbn tanbn lnbn log10bn     bn
%   -    pibn   bn
%   any  typchk (bignumtype) (matrixtype) or the PostScript type name
% ---------------------------------------------------------------------------

/bnDebug false def
/bnn 20 def
/setbnsize {
	dup type /integertype ne 1 index 1 lt or { /setbnsize errordict /rangecheck get exec } if
	/bnn exch def
} def

% string utility: (ab) (cd) mergestr -> (abcd)   (new string, inputs unchanged)
/mergestr {2 copy length exch length add string dup dup
	4 3 roll 4 index length exch putinterval 3 1 roll exch
	0 exch putinterval
} def

% ===========================================================================
% Internal helpers - digit arrays (most significant digit first)
% Names starting bn_ are internal.  Results are always new arrays; inputs are
% never modified.
% ===========================================================================
/bn_max { 2 copy lt { exch } if pop } bind def
/bn_min { 2 copy gt { exch } if pop } bind def
/bn_s2a { [ exch { 48 sub } forall ] } bind def          % (123) -> [1 2 3]
/bn_a2s {                                                 % [1 2 3] -> (123)
	dup length string
	0 1 2 index length 1 sub { dup 3 index exch get 48 add 2 index 3 1 roll put } for
	exch pop
} bind def
/bn_zeros { [ exch { 0 } repeat ] } bind def             % n -> [0 ... 0]
/bn_cat {                                                 % a b -> a++b
	1 index length 1 index length add array
	dup 0 4 index putinterval
	dup 3 index length 3 index putinterval
	3 1 roll pop pop
} bind def
/bn_strip {                                               % drop leading zeros
	0 { 1 index length 1 index eq { exit } if
	    1 index 1 index get 0 ne { exit } if
	    1 add } loop
	1 index length 1 index sub getinterval
} bind def
/bn_iszeroA { true exch { 0 ne { pop false exit } if } forall } bind def

/bn_natcmp {                                              % a b -> -1 0 1
	bn_strip exch bn_strip exch
	1 index length 1 index length
	2 copy gt { pop pop pop pop 1 }{
	lt { pop pop -1 }{
		0
		0 1 3 index length 1 sub {
			3 index 1 index get 3 index 2 index get
			2 copy gt { pop pop pop pop 1 exit } if
			lt { pop pop -1 exit } if
			pop
		} for
		3 1 roll pop pop
	} ifelse } ifelse
} bind def

/bn_natadd {                                              % a b -> a+b
8 dict begin
	/b exch def /a exch def /la a length def /lb b length def
	/n la lb bn_max 1 add def /r n array def /c 0 def
	0 1 n 1 sub { /k exch def
		/s c def
		k la lt { /s s a la 1 sub k sub get add def } if
		k lb lt { /s s b lb 1 sub k sub get add def } if
		r n 1 sub k sub s 10 mod put
		/c s 10 idiv def
	} for
	r
end
} bind def

/bn_natsub {                                              % a b -> a-b  (a>=b)
8 dict begin
	/b exch def /a exch def /la a length def /lb b length def
	/n la lb bn_max def /r n array def /c 0 def
	0 1 n 1 sub { /k exch def
		/s 0 c sub def
		k la lt { /s s a la 1 sub k sub get add def } if
		k lb lt { /s s b lb 1 sub k sub get sub def } if
		s 0 lt { /s s 10 add def /c 1 def }{ /c 0 def } ifelse
		r n 1 sub k sub s put
	} for
	r
end
} bind def

/bn_natmul {                                              % a b -> a*b
8 dict begin
	/b exch def /a exch def /la a length def /lb b length def
	/r la lb add bn_zeros def
	la 1 sub -1 0 { /i exch def
		/ai a i get def
		ai 0 ne {
			/c 0 def
			lb 1 sub -1 0 { /j exch def
				/p r i j add 1 add get ai b j get mul add c add def
				r i j add 1 add p 10 mod put
				/c p 10 idiv def
			} for
			r i c put
		} if
	} for
	r
end
} bind def

/bn_natdiv {                                              % a b -> floor(a/b)
8 dict begin
	bn_strip /b exch def /a exch def
	/q a length array def /rem 0 array def
	0 1 a length 1 sub { /i exch def
		/rem rem [ a i get ] bn_cat bn_strip def
		/d 0 def
		{ rem b bn_natcmp 0 lt { exit } if
		  /rem rem b bn_natsub bn_strip def /d d 1 add def } loop
		q i d put
	} for
	q
end
} bind def

% ===========================================================================
% Internal helpers - bignums
% ===========================================================================
/bn_norm {               % sign digitarray exponent -> bignum rounded to bnn
8 dict begin
	/e exch def bn_strip /d exch def /s exch def
	d length 0 eq { [ true bnn bn_zeros bn_a2s 0 ] }{
		d length bnn gt {
			/up d bnn get 5 ge def
			/e e d length bnn sub add def
			/d d 0 bnn getinterval def
			up { /d d [ 1 ] bn_natadd bn_strip def
			     d length bnn gt { /d d 0 bnn getinterval def /e e 1 add def } if } if
		}{
			d length bnn lt { /pad bnn d length sub def
				/d d pad bn_zeros bn_cat def /e e pad sub def } if
		} ifelse
		[ s d bn_a2s e ]
	} ifelse
end
} bind def

/bn_parts { aload pop exch bn_s2a exch } bind def        % bn -> sign array exp
/bn_renorm { bn_parts bn_norm } bind def                  % round to current bnn
/bniszero { 1 get bn_s2a bn_iszeroA } bind def
/bn_lead {               % bn -> exponent of leading digit (zero -> -1000000000)
	bn_parts 3 -1 roll pop exch bn_strip
	dup length 0 eq { pop pop -1000000000 }{ length 1 sub add } ifelse
} bind def
/bn_tiny {               % term sum -> true if term is below sum's last digit
	exch dup bniszero { pop pop true }{
		bn_lead exch bn_lead bnn sub 1 sub lt } ifelse
} bind def
/bn_magcmp {             % a b -> compare |a| |b|
8 dict begin
	/B exch def /A exch def
	/la A bn_lead def /lb B bn_lead def
	la lb ne { la lb gt { 1 }{ -1 } ifelse }{
		A bn_parts /ae exch def /ad exch def pop
		B bn_parts /be exch def /bd exch def pop
		/e ae be bn_min def
		ad ae e sub bn_zeros bn_cat  bd be e sub bn_zeros bn_cat  bn_natcmp
	} ifelse
end
} bind def

% ===========================================================================
% Conversion
% ===========================================================================
/setbn {                 % integer | real | (string) | bignum -> bignum
12 dict begin
	dup type /arraytype eq { bn_renorm }{
	dup type /stringtype ne { 40 string cvs } if
	/str exch def
	/s true def /pt -1 def /ex 0 def /esign 1 def /mode 0 def /nd 0 def /ok true def
	mark
	str { /ch exch def
		mode 0 eq {
			ch 48 ge ch 57 le and { ch 48 sub /nd nd 1 add def }{
			ch 46 eq pt 0 lt and { /pt nd def }{
			ch 45 eq nd 0 eq and { /s false def }{
			ch 43 eq nd 0 eq and { }{
			ch 101 eq ch 69 eq or nd 0 gt and { /mode 1 def }{
			/ok false def } ifelse } ifelse } ifelse } ifelse } ifelse
		}{
			ch 48 ge ch 57 le and { /ex ex 10 mul ch 48 sub add def /mode 2 def }{
			ch 45 eq mode 1 eq and { /esign -1 def }{
			ch 43 eq mode 1 eq and { }{ /ok false def } ifelse } ifelse } ifelse
		} ifelse
	} forall
	counttomark array astore /d exch def pop
	ok nd 0 gt and mode 1 ne and not { str /setbn errordict /syntaxerror get exec } if
	/e ex esign mul pt 0 ge { nd pt sub sub } if def
	s d e bn_norm
	} ifelse
	bnDebug { dup bnPrint } if
end
} bind def

/bncvs {                 % bignum -> (+d.ddddde<exp>)
8 dict begin
	aload pop /e exch def /str exch def /s exch def
	/ex str bn_s2a bn_iszeroA { 0 }{ e str length add 1 sub } ifelse def
	s { (+) }{ (-) } ifelse
	str 0 1 getinterval mergestr (.) mergestr
	str 1 str length 1 sub getinterval mergestr
	(e) mergestr ex 20 string cvs mergestr
end
} bind def

/bnPrint { bncvs = } bind def
/bncvr { bncvs cvr } bind def

% ===========================================================================
% Arithmetic
% ===========================================================================
/bn_copy { aload pop 3 1 roll dup length string copy 3 -1 roll 3 array astore } bind def
/negbn {
	dup bniszero { bn_copy }{
	aload pop 3 1 roll dup length string copy exch not exch 3 -1 roll 3 array astore } ifelse
} bind def
/absbn { bn_copy dup 0 true put } bind def

/addbn {
12 dict begin
	/B exch def /A exch def
	A bniszero { B bn_renorm }{ B bniszero { A bn_renorm }{
	/la A bn_lead def /lb B bn_lead def
	la lb sub bnn 2 add gt { A bn_renorm }{
	lb la sub bnn 2 add gt { B bn_renorm }{
		A bn_parts /ae exch def /ad exch def /as exch def
		B bn_parts /be exch def /bd exch def /bs exch def
		/e ae be bn_min def
		/ad ad ae e sub bn_zeros bn_cat def
		/bd bd be e sub bn_zeros bn_cat def
		as bs eq { as ad bd bn_natadd e bn_norm }{
			ad bd bn_natcmp dup 0 eq { pop true [ 0 ] 0 bn_norm }{
			0 gt { as ad bd bn_natsub e bn_norm }{ bs bd ad bn_natsub e bn_norm } ifelse
			} ifelse
		} ifelse
	} ifelse } ifelse } ifelse } ifelse
	bnDebug { dup bnPrint } if
end
} bind def

/subbn { negbn addbn } bind def

/mulbn {
8 dict begin
	/B exch def /A exch def
	A bn_parts /ae exch def /ad exch def /as exch def
	B bn_parts /be exch def /bd exch def /bs exch def
	as bs eq  ad bd bn_natmul  ae be add  bn_norm
	bnDebug { dup bnPrint } if
end
} bind def

/divbn {
10 dict begin
	/B exch def /A exch def
	B bniszero { A B /divbn errordict /undefinedresult get exec } if
	A bn_parts /ae exch def bn_strip /ad exch def /as exch def
	B bn_parts /be exch def bn_strip /bd exch def /bs exch def
	/k bnn 2 add bd length add ad length sub 0 bn_max def
	as bs eq  ad k bn_zeros bn_cat bd bn_natdiv  ae be sub k sub  bn_norm
	bnDebug { dup bnPrint } if
end
} bind def

/truncbn {               % integer part, toward zero
8 dict begin
	bn_parts /e exch def /d exch def /s exch def
	e 0 ge { s d e bn_norm }{
		d length e neg le { true [ 0 ] 0 bn_norm }{
		s d 0 d length e add getinterval 0 bn_norm } ifelse
	} ifelse
end
} bind def

/roundbn {               % nearest integer, halves away from zero
	dup 0 get { (0.5) }{ (-0.5) } ifelse setbn addbn truncbn
} bind def

% ===========================================================================
% Comparison
% ===========================================================================
/cmpbn {
8 dict begin
	/B exch def /A exch def
	/sa A bniszero { 0 }{ A 0 get { 1 }{ -1 } ifelse } ifelse def
	/sb B bniszero { 0 }{ B 0 get { 1 }{ -1 } ifelse } ifelse def
	sa sb ne { sa sb gt { 1 }{ -1 } ifelse }{
		sa 0 eq { 0 }{ A B bn_magcmp sa mul } ifelse
	} ifelse
end
} bind def
/eqbn { cmpbn 0 eq } bind def
/nebn { cmpbn 0 ne } bind def
/gtbn { cmpbn 0 gt } bind def
/gebn { cmpbn 0 ge } bind def
/ltbn { cmpbn 0 lt } bind def
/lebn { cmpbn 0 le } bind def

% ===========================================================================
% Transcendental functions
% Each is computed with bn_guard extra digits and rounded to bnn at the end.
% ===========================================================================
/bn_guard 6 def
/bn_cache 10 dict def

/bn_prec {               % x extra {proc} -> proc applied to x at higher precision
8 dict begin
	/bn_prec_p exch def
	/bn_prec_out bnn def
	/bnn exch bnn add bn_guard add def
	bn_renorm bn_prec_p exec
	/bnn bn_prec_out def
	bn_renorm
end
} bind def

/bn_cachedget {          % /key {proc} -> value of proc at bnn (computed once)
8 dict begin
	/bn_cg_p exch def /bn_cg_k exch def
	bn_cache bn_cg_k known { bn_cache bn_cg_k get 0 get bnn ge }{ false } ifelse
	{ bn_cache bn_cg_k get 1 get bn_renorm }{
		bn_cg_p exec /bn_cg_v exch def
		bn_cache bn_cg_k [ bnn bn_cg_v ] put
		bn_cg_v
	} ifelse
end
} bind def

/bn_atan_inv {           % int k -> atan(1/k)
8 dict begin
	/k exch def
	/k2 k k mul setbn def
	/p 1 setbn k setbn divbn def
	/sum p def /i 0 def /sg true def
	{ /i i 1 add def /sg sg not def
	  /p p k2 divbn def
	  /t p 2 i mul 1 add setbn divbn def
	  t sum bn_tiny { exit } if
	  /sum sum sg { t }{ t negbn } ifelse addbn def
	} loop
	sum
end
} bind def

/bn_pi {                 % Machin: pi = 16 atan(1/5) - 4 atan(1/239)
	/PI { 16 setbn 5 bn_atan_inv mulbn 4 setbn 239 bn_atan_inv mulbn subbn } bn_cachedget
} bind def

/bn_atanh2 {             % z -> 2 atanh(z) = ln((1+z)/(1-z))
8 dict begin
	/z exch def /z2 z z mulbn def /p z def /sum z def /i 0 def
	{ /i i 1 add def /p p z2 mulbn def
	  /t p 2 i mul 1 add setbn divbn def
	  t sum bn_tiny { exit } if
	  /sum sum t addbn def
	} loop
	sum 2 setbn mulbn
end
} bind def

/bn_ln2 { /LN2 { 1 setbn 3 setbn divbn bn_atanh2 } bn_cachedget } bind def
/bn_ln10 {               % ln 10 = 3 ln 2 + ln 1.25
	/LN10 { bn_ln2 3 setbn mulbn 1 setbn 9 setbn divbn bn_atanh2 addbn } bn_cachedget
} bind def

/bn_reduce {             % x -> x - 2pi*round(x/2pi), in [-pi, pi]
8 dict begin
	/x exch def /tp bn_pi 2 setbn mulbn def
	x x tp divbn roundbn tp mulbn subbn
end
} bind def

/bn_sin_wp {
8 dict begin
	bn_reduce /r exch def /r2 r r mulbn def
	/t r def /sum r def /i 1 def
	{ /t t r2 mulbn i 2 mul dup 1 add mul setbn divbn negbn def
	  t sum bn_tiny { exit } if
	  /sum sum t addbn def /i i 1 add def
	} loop
	sum
end
} bind def

/bn_cos_wp {
8 dict begin
	bn_reduce /r exch def /r2 r r mulbn def
	/t 1 setbn def /sum t def /i 1 def
	{ /t t r2 mulbn i 2 mul dup 1 sub mul setbn divbn negbn def
	  t sum bn_tiny { exit } if
	  /sum sum t addbn def /i i 1 add def
	} loop
	sum
end
} bind def

/bn_lnsplit {            % x>0 -> ln(m) k   where x = m * 10^k, 1 <= m < 10
8 dict begin
	bn_parts /e exch def bn_strip /d exch def pop
	/k e d length add 1 sub def
	/m true d 1 d length sub bn_norm def
	/lim (1.5) setbn def /half (0.5) setbn def /j 0 def
	{ m lim gebn not { exit } if /m m half mulbn def /j j 1 add def } loop
	/one 1 setbn def
	m one subbn m one addbn divbn bn_atanh2
	j setbn bn_ln2 mulbn addbn
	k
end
} bind def

/bn_chkpos {             % bn /opname -> bn   rangecheck unless bn > 0
	1 index dup bniszero exch 0 get not or { errordict /rangecheck get exec }{ pop } ifelse
} bind def

/sinbn { dup bn_lead 0 bn_max { bn_sin_wp } bn_prec } bind def
/cosbn { dup bn_lead 0 bn_max { bn_cos_wp } bn_prec } bind def
/tanbn { dup bn_lead 0 bn_max { dup bn_sin_wp exch bn_cos_wp divbn } bn_prec } bind def
/lnbn {
	/lnbn bn_chkpos
	0 { bn_lnsplit setbn bn_ln10 mulbn addbn } bn_prec
} bind def
/log10bn {
	/log10bn bn_chkpos
	0 { bn_lnsplit exch bn_ln10 divbn exch setbn addbn } bn_prec
} bind def
/pibn { 0 setbn 0 { pop bn_pi } bn_prec } bind def

% ===========================================================================
% Type check for the library's composite types
% ===========================================================================
/typchk { % any -> (bignumtype) (matrixtype) or (<type>)
10 dict begin
	dup /object exch def
	type 20 string cvs /query exch def
	query (arraytype) eq { object length 0 gt }{ false } ifelse {
		object 0 get type /arraytype eq { (matrixtype) }{
			object length 3 eq {
				object 0 get type /booleantype eq
				object 1 get type /stringtype eq and
				object 2 get type /integertype eq and
			}{ false } ifelse
			{ (bignumtype) }{ query } ifelse
		} ifelse
	}{ query } ifelse
end
} bind def

end
